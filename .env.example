# Database Configuration
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/forgery_detection_db
SQLITE_FALLBACK_URL=sqlite:///./forgery_detection.db

# JWT Security
SECRET_KEY=super-secret-jwt-forgery-detection-key-2026-secure-change-in-prod
