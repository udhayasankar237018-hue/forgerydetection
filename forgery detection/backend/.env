# ==============================================================================
# AI-Based Document Forgery Detection - Environment Configuration
# ==============================================================================

# Application & Security
PROJECT_NAME="AI-Based Document Forgery Detection"
SECRET_KEY="super-secret-jwt-forgery-detection-key-2026-secure-change-in-prod"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM="HS256"

# Database Configuration
# Default is MySQL. If MySQL is unavailable, backend automatically falls back to SQLite.
DATABASE_URL="mysql+pymysql://root:root@localhost:3306/forgery_detection_db"
SQLITE_FALLBACK_URL="sqlite:///./forgery_detection.db"

# Storage Settings
MAX_FILE_SIZE_MB=15
OCR_LANGUAGE="eng"

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","*"]

# ==============================================================================
# SMTP Email Server Configuration (For Password Reset OTP Dispatch)
# ==============================================================================
# Example for Gmail:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-16-character-app-password"
# SMTP_TLS=True
# EMAILS_FROM_EMAIL="your-email@gmail.com"
# EMAILS_FROM_NAME="ForgeryGuard AI Security Operations"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_TLS=True
EMAILS_FROM_EMAIL="security@forgeryguard.ai"
EMAILS_FROM_NAME="ForgeryGuard AI Security"
FRONTEND_URL="http://localhost:5173"
